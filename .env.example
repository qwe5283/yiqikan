# Docker Compose 映射到宿主机的端口；容器内部端口保持 3000
APP_PORT=3000

# 单个上传文件的最大字节数，默认 2147483648（2 GiB）
MAX_FILE_SIZE_BYTES=2147483648

# 可选：Linux 公网服务器启用 coturn。先填写配置，再取消 COMPOSE_FILE 注释。
# COMPOSE_FILE=docker-compose.yml:docker-compose.turn.yml
# TURN_HOST=turn.example.com
# TURN_EXTERNAL_IP=203.0.113.10
# 使用 openssl rand -hex 32 生成随机密钥，不要提交真实值。
# TURN_SECRET=replace-with-random-secret
# TURN_PORT=3478
# TURN_MIN_PORT=49152
# TURN_MAX_PORT=49252
# TURN_CREDENTIAL_TTL_SECONDS=86400
